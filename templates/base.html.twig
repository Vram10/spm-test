<!DOCTYPE html>
<html lang="de" data-bs-theme="light" data-bs-theme-primary="blue" data-bs-theme-base="neutral"
      data-bs-theme-radius="0.5">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Kaufdort - Empfehlungen{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
