{% extends 'page.html.twig' %}
{% block content %}
    <div class="container-xl">
        <!-- Hero -->
        <div class="hero pb-4">
            <div class="container-tight">
                <div class="text-center mb-4">
                    <h1 class="display-3 mb-2">Von Ostfriesen für Ostfrieland</h1>
                    <h2 class="display-6 text-muted">Kaufempfehlungen die wirken.</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Datei für die Analyse</h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(upload_form) }}

                            {% for child in upload_form %}
                                {% if child.vars.name != '_token' %}
                                    <div class="mb-3">

                                        {{ form_label(child, null, {
                                            label_attr: {
                                                class: 'form-label'
                                            }
                                        }) }}

                                        {{ form_widget(child, {
                                            attr: {
                                                class: 'form-control'
                                            }
                                        }) }}

                                        {# Feldfehler #}
                                        {% if child.vars.errors|length > 0 %}
                                            <div class="mt-2">
                                                {% for error in child.vars.errors %}
                                                    <div class="text-danger small d-flex align-items-center gap-1">
                                                        <i class="ti ti-alert-circle"></i>
                                                        {{ error.message }}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}

                                    </div>
                                {% endif %}
                            {% endfor %}

                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('app_index') }}"
                                   class="btn btn-outline-secondary">
                                    Abbrechen
                                </a>

                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i>
                                    Speichern
                                </button>
                            </div>

                            {{ form_end(upload_form) }}
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
